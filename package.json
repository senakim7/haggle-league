{
  "name": "haggle-league",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "check": "turbo run typecheck test",
    "sim": "pnpm --filter @haggle/sim start",
    "match": "pnpm --filter @haggle/sim match",
    "db:generate": "pnpm --filter @haggle/db generate",
    "db:migrate": "pnpm --filter @haggle/db migrate",
    "db:seed": "pnpm --filter @haggle/db seed",
    "api": "pnpm --filter @haggle/api dev",
    "worker": "pnpm --filter @haggle/worker dev"
  },
  "devDependencies": {
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
