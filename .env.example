# 무료 티어 키만 넣는다. 결제가 연결된 계정·프로젝트의 키는 쓰지 않는다(AGENTS.md).
# Gemini: Cloud Billing이 연결되지 않은 AI Studio 프로젝트에서 발급 (https://aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=
# Mistral: 무료 플랜(Experiment) 키 (https://console.mistral.ai/api-keys)
MISTRAL_API_KEY=

# 로컬 개발 (docker compose up -d)
DATABASE_URL=postgres://haggle:haggle@localhost:5432/haggle
REDIS_URL=redis://localhost:6379
WEB_ORIGIN=http://localhost:3000
BETTER_AUTH_URL=http://localhost:8787
# 32자 이상 임의 문자열: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
# OAuth 앱을 만들기 전까지 개발용 이메일 로그인을 켠다. 운영에서는 켜면 API가 시작되지 않는다.
AUTH_DEV_LOGIN=1
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 리그·연습 경기에 쓸 무료 모델 (models.ts 허용 목록 중 하나)
LEAGUE_MODEL=google/gemini-2.5-flash-lite
